# ---- Обязательно ----
TELEGRAM_BOT_TOKEN=          # от @BotFather
ANTHROPIC_API_KEY=           # console.anthropic.com → API Keys
ALLOWED_USER_IDS=            # ваш Telegram id (бот скажет его на /start); несколько — через запятую

# ---- Автотека (бизнес-доступ через Avito API). Пусто — этап пропускается, VIN пробиваете вручную
AUTOTEKA_CLIENT_ID=
AUTOTEKA_CLIENT_SECRET=

# ---- Цена закупки
SELLER_DISCOUNT=0.15         # скидка продавца
CASH_FACTOR=0.86             # цена за наличку для машин с полным НДС
DEFAULT_FULL_VAT=true        # если в файле нет колонки «НДС»

# ---- Этап 1: отсев по файлу
MIN_YEAR=2018               # 0 — тогда считается по MAX_AGE_YEARS
MAX_AGE_YEARS=8
MAX_MILEAGE_KM=100000
MAX_KM_PER_YEAR=30000
BLACKLIST=                   # например: lada, datsun, ravon, chery tiggo 4
# Колонки реестра лизинговой компании (через запятую, ищется вхождение, регистр не важен)
VEHICLE_TYPES=легковой
SKIP_STATUSES=резерв,отгрузка
BAD_CONDITIONS=hard,удовлетвор
BAD_WORDS=тотал,сгор,погорел,утоп,перевертыш,перевёртыш,не на ходу,хлам,не продавать,проблемное,после дтп,криминал,арест,розыск,залог

# ---- Этап 2: рынок
MIN_LIQUIDITY=6              # из 10
SALE_DISCOUNT=0.05           # торг при продаже
PREP_COST_RUB=40000          # подготовка + оформление
MIN_PROFIT_RUB=400000
MARKET_CONCURRENCY=3
USD_PER_MARKET_CHECK=0.4    # только для прикидки стоимости перед запуском
ANTHROPIC_MODEL=claude-opus-5

# ---- Этап 3: Автотека
MAX_OWNERS=2
MAX_ACCIDENTS=1
MILEAGE_TOLERANCE_KM=3000
