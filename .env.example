# ---- Telegram (не нужен, если запускаете через проверить_файл.bat / python -m carbot.cli) ----
TELEGRAM_BOT_TOKEN=          # от @BotFather
ALLOWED_USER_IDS=            # ваш Telegram id (бот скажет его на /start); несколько — через запятую

# ---- Откуда брать рынок ----
MARKET_SOURCE=free           # free — бесплатно, сам собираю цены; claude — платно, нужен ANTHROPIC_API_KEY
MARKET_SOURCES=drom,autoru,avito
SOURCES_REQUIRED=0           # сколько площадок обязательно проверить для вывода; 0 — все из списка
DROM_MAX_PAGES=3             # страниц по 20 объявлений на модель
DROM_DELAY_MIN=2             # паузы между запросами к Дрому, сек (меньше — быстрее, но выше риск капчи)
DROM_DELAY_MAX=5
# Авто.ру и Авито открываются в настоящем браузере
BROWSER_HEADLESS=false       # false — окно видно, капчу «я не робот» решаете вы; true — для сервера без экрана
BROWSER_CHANNEL=chrome       # ваш установленный Chrome; пусто — встроенный Chromium
BROWSER_DELAY_MIN=2
BROWSER_DELAY_MAX=5
CAPTCHA_WAIT_SEC=180         # сколько ждать, пока решите капчу
AUTORU_MAX_PAGES=2
AVITO_MAX_PAGES=2
ANTHROPIC_API_KEY=           # только для MARKET_SOURCE=claude

# ---- Автотека (бизнес-доступ через Avito API). Пусто — этап пропускается, VIN пробиваете вручную
AUTOTEKA_CLIENT_ID=
AUTOTEKA_CLIENT_SECRET=

# ---- Цена закупки
SELLER_DISCOUNT=0.15         # скидка продавца
CASH_FACTOR=0.86             # цена за наличку для машин с полным НДС
DEFAULT_FULL_VAT=true        # если в файле нет колонки «НДС»

# ---- Этап 1: отсев по файлу
MIN_YEAR=2018               # 0 — тогда считается по MAX_AGE_YEARS
MAX_AGE_YEARS=8
MIN_MILEAGE_KM=2             # пробег 0–1 км (или пусто) — машину не смогли запустить, не смотрим
MAX_MILEAGE_KM=100000
MAX_KM_PER_YEAR=30000
BLACKLIST=                   # например: lada, datsun, ravon, chery tiggo 4
# Колонки реестра лизинговой компании (через запятую, ищется вхождение, регистр не важен)
VEHICLE_TYPES=легковой
ALLOW_STATUSES=в продаже        # остальные статусы (резерв, отгрузка, оценка…) пропускаем
SKIP_NO_KEYS=true             # «Нет ключей» не рассматриваем
SKIP_RHD=true                 # правый руль не рассматриваем
BAD_CONDITIONS=hard,удовлетвор
BAD_WORDS=тотал,сгор,погорел,утоп,перевертыш,перевёртыш,не на ходу,хлам,не продавать,проблемное,после дтп,криминал,арест,розыск,залог

# ---- Этап 2: рынок
MIN_LIQUIDITY=6              # из 10
SALE_DISCOUNT=0.05           # торг при продаже
PREP_COST_RUB=40000          # подготовка + оформление
MIN_PROFIT_RUB=400000
MARKET_CONCURRENCY=3
USD_PER_MARKET_CHECK=0.4    # для режима claude: прикидка стоимости перед запуском
ANTHROPIC_MODEL=claude-opus-5

# ---- Этап 3: Автотека
MAX_OWNERS=2
MAX_ACCIDENTS=1
MILEAGE_TOLERANCE_KM=3000
