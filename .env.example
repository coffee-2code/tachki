# ---- Telegram (не нужен, если запускаете через проверить_файл.bat / python -m carbot.cli) ----
# от @BotFather
TELEGRAM_BOT_TOKEN=
# ваш Telegram id (бот скажет его на /start); несколько — через запятую
ALLOWED_USER_IDS=

# ---- Откуда брать рынок ----
# free — бесплатно, сам собираю цены; claude — платно, нужен ANTHROPIC_API_KEY
MARKET_SOURCE=free
MARKET_SOURCES=drom,autoru,avito
# сколько площадок обязательно проверить для вывода; 0 — все из списка
SOURCES_REQUIRED=0
# страниц по 20 объявлений на модель
DROM_MAX_PAGES=3
# паузы между запросами к Дрому, сек (меньше — быстрее, но выше риск капчи)
DROM_DELAY_MIN=2
DROM_DELAY_MAX=5
# Авто.ру и Авито открываются в настоящем браузере
# false — окно видно, капчу «я не робот» решаете вы; true — для сервера без экрана
BROWSER_HEADLESS=false
# chrome — ваш установленный Chrome; chromium — встроенный браузер
BROWSER_CHANNEL=chrome
BROWSER_DELAY_MIN=2
BROWSER_DELAY_MAX=5
# сколько ждать, пока решите капчу
CAPTCHA_WAIT_SEC=180
AUTORU_MAX_PAGES=2
AVITO_MAX_PAGES=2
# только для MARKET_SOURCE=claude
ANTHROPIC_API_KEY=

# ---- Автотека (бизнес-доступ через Avito API). Пусто — этап пропускается, VIN пробиваете вручную
AUTOTEKA_CLIENT_ID=
AUTOTEKA_CLIENT_SECRET=

# ---- Цена закупки
# скидка продавца
SELLER_DISCOUNT=0.15
# цена за наличку для машин с полным НДС
CASH_FACTOR=0.86
# если в файле нет колонки «НДС»
DEFAULT_FULL_VAT=true

# ---- Этап 1: отсев по файлу
# 0 — тогда считается по MAX_AGE_YEARS
MIN_YEAR=2018
MAX_AGE_YEARS=8
# пробег 0–1 км (или пусто) — машину не смогли запустить, не смотрим
MIN_MILEAGE_KM=2
MAX_MILEAGE_KM=100000
MAX_KM_PER_YEAR=30000
# например: lada, datsun, ravon, chery tiggo 4
BLACKLIST=
# Колонки реестра лизинговой компании (через запятую, ищется вхождение, регистр не важен)
VEHICLE_TYPES=легковой
ALLOW_STATUSES=в продаже        # остальные статусы (резерв, отгрузка, оценка…) пропускаем
# «Нет ключей» не рассматриваем
SKIP_NO_KEYS=true
# правый руль не рассматриваем
SKIP_RHD=true
BAD_CONDITIONS=hard,удовлетвор
BAD_WORDS=тотал,сгор,погорел,утоп,перевертыш,перевёртыш,не на ходу,хлам,не продавать,проблемное,после дтп,криминал,арест,розыск,залог

# ---- Этап 2: рынок
# из 10
MIN_LIQUIDITY=6
# торг при продаже
SALE_DISCOUNT=0.05
# подготовка + оформление
PREP_COST_RUB=40000
MIN_PROFIT_RUB=400000
MARKET_CONCURRENCY=3
# для режима claude: прикидка стоимости перед запуском
USD_PER_MARKET_CHECK=0.4
ANTHROPIC_MODEL=claude-opus-5

# ---- Этап 3: Автотека
MAX_OWNERS=2
MAX_ACCIDENTS=1
MILEAGE_TOLERANCE_KM=3000
